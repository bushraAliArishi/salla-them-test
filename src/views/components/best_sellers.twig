<section class="best-sellers">
    <div class="container">
        <h3>{{ lang('best_sellers_title') }}</h3>
        <div class="product-grid">
            {# Loop through best selling products #}
            {% for product in store.best_selling_products %}
                <div class="product-card">
                    <a href="{{ product.url }}">
                        <img src="{{ product.image }}" alt="{{ product.name }}">
                        <h4>{{ product.name }}</h4>
                        <p class="price">{{ product.price | currency }}</p>
                        <button class="quick-add-btn">{{ lang('quick_add') }}</button>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
