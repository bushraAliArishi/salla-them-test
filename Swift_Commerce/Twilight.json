{
  "name": "Swift Commerce",
  "version": "1.0.0",
  "description": "A fast, clean, and conversion-optimized theme designed for quick shopping experiences.",
  "author": "Manus AI",
  "preview_image": "assets/images/preview.png",
  "settings": [
    {
      "id": "primary_color",
      "type": "color",
      "label": "Primary Action Color",
      "default": "#007bff"
    },
    {
      "id": "product_list_style",
      "type": "select",
      "label": "Product List Style",
      "options": [
        {"label": "Compact Grid", "value": "compact"},
        {"label": "Detailed List", "value": "list"}
      ],
      "default": "compact"
    }
  ],
  "features": {
    "one_click_buy": true,
    "mini_cart": true,
    "fast_search": true
  },
  "components": {
    "home": [
      {"id": "promo_banner", "name": "Promotional Banner"},
      {"id": "best_sellers", "name": "Best Sellers"},
      {"id": "quick_links_grid", "name": "Quick Links Grid"}
    ],
    "product": [
      {"id": "product_info_compact", "name": "Compact Product Info"},
      {"id": "customer_reviews", "name": "Customer Reviews"}
    ]
  }
}


